# Machine-local configuration for the DHB_AX image.
#
# Copy this file to local.env and fill it in:
#
#     install -m 600 local.env.example local.env
#
# The format is POSIX shell KEY=value, so that needs a machine-specific
# value can read it with `.`. Keep it to plain assignments: it is
# sourced, not parsed, and a command here runs at build time.

#
# Shared bare clone of the stable Linux Git repository used to prepare the
# editable kernel patch workspace.
#
DHB_AX_LINUX_REPOSITORY=$HOME/workspace/linux

#
# Pi proxy host bridging UART access and serving TFTP.
#
DHB_AX_PI_IPADDR=192.168.4.34

#
# Network parameters for the DVR. Boot tooling uses all four values, and the
# Debian rootfs builder installs DHB_AX_DVR_ETHADDR in its systemd .link file.
#
DHB_AX_DVR_IPADDR=192.168.4.77
DHB_AX_DVR_NETMASK=255.255.252.0
DHB_AX_DVR_ETHADDR=00:18:AE:3C:A2:49
