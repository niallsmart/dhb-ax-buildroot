# Machine-local configuration for the DHB_AX image.
#
# Copy this file to local.env and fill it in:
#
#     install -m 600 local.env.example local.env
#
# `install -m 600` rather than `cp`: cp gives the copy this template's own
# permissions, which are world-readable because the template is tracked and
# holds nothing. The copy holds a password hash and should not be.
#
# local.env is gitignored; this template is tracked. The format is POSIX
# shell KEY=value, so scripts/buildroot-in-container.sh and anything else
# that needs a machine-specific value can read it with `.`. Keep it to plain
# assignments: it is sourced, not parsed, and a command here runs at build
# time.
#
# This repository is public. Values that must not be published belong here
# rather than in br2-external/configs/dhb_ax_defconfig, which is tracked and
# is rewritten in place by `scripts/buildroot.sh savedefconfig`.

# Root password for serial console login, as a crypt(3) hash.
#
# This is what the getty on the serial console authenticates against. SSH is
# public-key only and ignores it; the UART is the path with no key to offer.
#
# Generate a hash and paste the output:
#
#     openssl passwd -6
#
# Buildroot writes any value starting with $1$, $5$ or $6$ straight into
# /etc/shadow, so the cleartext password is never stored here or echoed into
# a build log. Single-quote the value: a crypt hash contains $ signs, and
# double quotes would let the shell eat them when this file is sourced.
DHB_AX_ROOT_PASSWD=''

# Development rig used by tools/dvr-* and `just dvr`. These reach the board
# over SSH, exclusively by IP address: one hop to the Raspberry Pi that
# bridges the DVR's UART and serves TFTP/NFS, and, once the DVR itself has
# network access, a second hop straight to it.
#
# All four values below are required: these tools have no built-in defaults
# and refuse to run without them. tools/dvr-boot.exp accepts --host,
# --serverip, --ipaddr, --netmask and --ethaddr as per-invocation overrides
# of the matching value; --host and --serverip both default to
# DHB_AX_PI_IPADDR. The DVR's SSH user is always root -- see tools/dvr-*.sh.
DHB_AX_PI_IPADDR=192.168.4.34

# Network parameters for the DVR, including configuration that
# tools/dvr-boot.exp gives U-Boot for TFTP/NFS boot. DHB_AX_DVR_IPADDR also
# doubles as the SSH target once Linux is running. Defaults here are from
# the LAN this port was developed against.
DHB_AX_DVR_IPADDR=192.168.4.77
DHB_AX_DVR_NETMASK=255.255.252.0
DHB_AX_DVR_ETHADDR=00:18:AE:3C:A2:49
