# BusyBox configuration fragment for the DHB-AX board.
#
# Merged on top of Buildroot's package/busybox/busybox.config.

# /init ends with `exec setsid cttyhack sh`, which is what gives the shell a
# controlling terminal so job control works on the serial console.  Buildroot's
# default config leaves cttyhack out, and without it setsid fails, /init exits,
# and the kernel panics with "Attempted to kill init!".
CONFIG_CTTYHACK=y
