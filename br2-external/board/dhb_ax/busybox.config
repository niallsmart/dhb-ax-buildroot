# BusyBox configuration fragment for the DHB-AX board.
#
# Merged on top of Buildroot's package/busybox/busybox.config.

# /init ends with `exec setsid cttyhack sh`, which is what gives the shell a
# controlling terminal so job control works on the serial console.  Buildroot's
# default config leaves cttyhack out, and without it setsid fails, /init exits,
# and the kernel panics with "Attempted to kill init!".
CONFIG_CTTYHACK=y

# The dvr-extract image's /init brings up the network, loads the SATA and vfat
# modules, mounts the recording partitions read-only and starts lighttpd.  All
# of the applets below are on in Buildroot's default busybox.config today, so
# these lines change nothing now -- they are here so a future default flip
# fails the build loudly instead of leaving /init unable to reach the disk or
# the network.  cttyhack above is the one this project has actually been bitten
# by; these are the same guard applied to /init's other hard dependencies.
CONFIG_MODPROBE=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_IP=y
CONFIG_UDHCPC=y
