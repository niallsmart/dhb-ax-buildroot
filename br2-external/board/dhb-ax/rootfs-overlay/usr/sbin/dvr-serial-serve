#!/bin/sh
# Run from the idle root console; lend its UART to one SSH connection.
set -eu
exec 2>>/run/dvr-serial.log
[ -t 0 ] && [ -t 1 ] || exit 2
exec 3<&0 # BusyBox ash gives background commands /dev/null even with <&0.
saved_tty=$(stty -g)
server=
cleanup() {
    trap - EXIT
    set +e
    if [ -n "$server" ]; then kill "$server" 2>/dev/null; wait "$server" 2>/dev/null; fi
    # Linux TCFLSH=0x540b, TCIOFLUSH=2: discard ciphertext, then drain late bytes.
    socat -u -T 0.2 STDIN,ioctl-int=0x540b:2 /dev/null
    stty "$saved_tty"
    echo "7 4 1 7" > /proc/sys/kernel/printk
    echo N > /sys/module/printk/parameters/ignore_loglevel
}
trap cleanup EXIT
trap 'exit 1' TERM
printf N > /sys/module/printk/parameters/ignore_loglevel
echo 0 > /proc/sys/kernel/printk
stty raw -echo -ixon -ixoff -crtscts cs8 -parenb -cstopb clocal 115200

# Inetd mode uses the UART directly; no listener or transport relay.
/usr/sbin/sshd -i -e -o ClientAliveInterval=10 -o ClientAliveCountMax=3 \
    -o LoginGraceTime=60 <&3 &
server=$!
wait "$server"
