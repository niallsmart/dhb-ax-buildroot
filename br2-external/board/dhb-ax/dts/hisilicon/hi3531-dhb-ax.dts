// SPDX-License-Identifier: GPL-2.0-only
/*
 * Shenzhen TVT Digital motherboard marked DHB_AX V1.2, using the HiSilicon
 * Hi3531.  Developed against an LTS LTD2704XE-P; the same board also ships
 * under other retail brands.
 *
 * Validated general-purpose bring-up for memory, SMP, GPIO, RTC, USB, SATA,
 * GMAC1 Ethernet and the watchdog.
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "hi3531.dtsi"

/ {
	model = "TVT DHB_AX V1.2 (Hi3531 DVR)";
	compatible = "tvt,dhb-ax", "hisilicon,hi3531";

	aliases {
		ethernet0 = &gmac1;
	};

	chosen {
		/* U-Boot supplies root= and mem=; Linux uses mem= to replace ATAG_MEM. */
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Two independent 512 MiB banks.  With U-Boot's data cache evicted,
	 * each bank retained distinct patterns 256 MiB apart and the words at
	 * 0x9f000000 and 0xdf000000 retained different patterns near the top
	 * of their respective banks.  A separate write confirmed that
	 * 0xa8000000 aliases 0x88000000, but that address is in the unmapped
	 * hole between the controllers; it does not imply that DDR1 at
	 * 0xc0000000 aliases DDR0.
	 *
	 * The vendor's "DRAM: 256 MiB" is a hardcoded constant in their U-Boot
	 * board file, not a measurement.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>,
		      <0xc0000000 0x20000000>;
	};

	/*
	 * No reserved-memory node, deliberately.
	 *
	 * The vendor passes mem=224M, so everything above 0x8e000000 is
	 * theirs -- 288 MiB of the 512 MiB bank.  This port claims
	 * 0x90000000-0x9fffffff inside that region and has passed sustained
	 * DMA tests there.
	 *
	 * U-Boot's video buffers sit at 0xc0000000 and 0xc1000000 in DDR1.
	 * They are not aliases of the kernel load area.  The display path
	 * only reads those buffers and this port does not use it, so it
	 * cannot corrupt RAM and does not justify withholding the bank from
	 * Linux.
	 *
	 * DDR0 is verified by filling nearly all of it with a known pattern
	 * and checksumming it.  If a change makes an abandoned media engine
	 * write either bank, extend that test across DDR1 before accepting
	 * the change.
	 */

	/*
	 * Bit-banged I2C, matching how the vendor reaches the DS1307.  Their
	 * gpioi2c module drives PL061 data bits 4 and 5 (offsets 0x40 and
	 * 0x80 in the address-masked data window) and sets both as outputs.
	 * Bank 12 is the only one of the nineteen whose direction register
	 * reads 0x30, and both pins sit high at rest, which is what an idle
	 * bus with pull-ups looks like.
	 *
	 * open-drain is required: I2C devices pull the line low and rely on
	 * the pull-up to return it high, so the controller must never drive
	 * high actively.  This registerless controller is a root child rather
	 * than a child of the simple-bus SoC node.
	 */
	i2c-gpio {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio12 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio12 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;   /* ~100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * Battery-backed DS1307-compatible clock.  The vendor module's
		 * default mode uses the DS1307 register map at 7-bit address 0x68;
		 * its separate PCF8563 mode uses 0x51.  Mainline rtc-ds1307 reads
		 * this device successfully and supplies rtc0/hctosys.  The exact
		 * package manufacturer remains unidentified.
		 *
		 * The SoC's own PL031 is not usable -- see hi3531.dtsi -- so this
		 * is the board's only real timekeeper.
		 */
		rtc@68 {
			compatible = "dallas,ds1307";
			reg = <0x68>;
		};
	};
};

/*
 * The outer cache is described in the .dtsi but left disabled there, so that
 * turning it off is a one-line device-tree change on either board rather than
 * a kernel rebuild.
 */
&l2 {
	status = "okay";
};

&timer0 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

/*
 * Watchdog, used as a deadman during risky bring-up: it only starts when
 * userspace opens /dev/watchdog, and U-Boot stops it at boot ("dog_close").
 */
&wdt {
	status = "okay";
};

&usbphy {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&sata {
	status = "okay";
};

&gmac1 {
	phy-mode = "rgmii";
	phy-handle = <&phy1>;
	max-speed = <1000>;
	status = "okay";
};

&mdio {
	phy1: ethernet-phy@1 {
		reg = <1>;
	};
};

/* All nineteen banks are brought out on this board. */
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&gpio2 { status = "okay"; };
&gpio3 { status = "okay"; };
&gpio4 { status = "okay"; };
&gpio5 { status = "okay"; };
&gpio6 { status = "okay"; };
&gpio7 { status = "okay"; };
&gpio8 { status = "okay"; };
&gpio9 { status = "okay"; };
&gpio10 { status = "okay"; };
&gpio11 { status = "okay"; };
&gpio12 { status = "okay"; };
&gpio13 { status = "okay"; };
&gpio14 { status = "okay"; };
&gpio15 { status = "okay"; };
&gpio16 { status = "okay"; };
&gpio17 { status = "okay"; };
&gpio18 { status = "okay"; };
