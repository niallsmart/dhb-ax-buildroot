// SPDX-License-Identifier: GPL-2.0-only
/*
 * Minimal RAM-only diagnostics: CPU, GIC, SP804 timer, PL011 UART0 and the
 * wired Ethernet path.
 *
 * Every other on-chip block stays disabled as hi3531.dtsi leaves it, so this
 * DTB reaches a shell without touching GPIO, USB, SATA, SPI or I2C.
 *
 * Developed against an LTS LTD2704XE-P; the same board also ships under
 * other retail brands.
 */
/dts-v1/;

#include "hi3531.dtsi"

/ {
	model = "TVT DHB_AX V1.2 (Hi3531 DVR, minimal)";
	compatible = "tvt,dhb-ax", "hisilicon,hi3531";

	aliases {
		ethernet0 = &gmac1;
	};

	chosen {
		/* U-Boot supplies mem=; Linux uses it to replace ATAG_MEM. */
		stdout-path = "serial0:115200n8";
	};

	/* Both 512 MiB banks; see hi3531-dhb-ax.dts for how this was measured. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>,
		      <0xc0000000 0x20000000>;
	};
};

&timer0 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&gmac1 {
	phy-mode = "rgmii";
	phy-handle = <&phy1>;
	max-speed = <1000>;
	status = "okay";
};

&mdio {
	phy1: ethernet-phy@1 {
		reg = <1>;
	};
};
