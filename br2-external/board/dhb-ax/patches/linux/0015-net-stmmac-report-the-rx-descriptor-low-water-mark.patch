+++ b/drivers/net/ethernet/stmicro/stmmac/hwif.h
@@ -215,6 +215,8 @@ struct stmmac_dma_ops {
 			u32 chan);
 	int (*dma_interrupt)(struct stmmac_priv *priv, void __iomem *ioaddr,
