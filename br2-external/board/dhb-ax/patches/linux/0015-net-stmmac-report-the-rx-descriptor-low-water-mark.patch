diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
@@ -77,6 +77,8 @@ static const struct stmmac_stats stmmac_gstrings_stats[] = {
 	STMMAC_STAT(rx_overflow_cntr),
 	STMMAC_STAT(rx_vlan),
 	STMMAC_STAT(rx_split_hdr_pkt_n),
+	/* Rx descriptor ring pressure */
+	STMMAC_STAT(rx_desc_low_water),
 	/* Tx/Rx IRQ error info */
 	STMMAC_STAT(tx_undeflow_irq),
 	STMMAC_STAT(tx_process_stopped_irq),
@@ -574,6 +576,11 @@ static void stmmac_get_ethtool_stats(struct net_device *dev,
 			     sizeof(u64)) ? (*(u64 *)p) : (*(u32 *)p);
 	}
 
+	/* rx_desc_low_water covers the interval between two reads, so the
+	 * value just reported ends one interval and starts the next.
+	 */
+	priv->xstats.rx_desc_low_water = priv->dma_conf.dma_rx_size;
+
 	pos = j;
 	for (i = 0; i < rx_queues_count; i++) {
 		struct stmmac_rxq_stats *rxq_stats = &priv->xstats.rxq_stats[i];
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -320,6 +320,53 @@ static inline u32 stmmac_rx_dirty(struct stmmac_priv *priv, u32 queue)
 	return dirty;
 }
 
+/**
+ * stmmac_rx_low_water - record how near the RX ring came to running dry
+ * @priv: driver private structure
+ * @queue: RX queue index
+ * Description: the descriptors still owned by the DMA are those from the
+ * one it is working on, which it reports in its current-descriptor
+ * register, up to the oldest one the driver has yet to hand back.  cur_rx
+ * and dirty_rx describe the driver's own progress and cannot answer this
+ * between them.  The minimum is latched here rather than sampled from
+ * outside because at 30k packets per second a 256-entry ring empties in
+ * under nine milliseconds.  Call this before refilling, so that the
+ * descriptor at dirty_rx is one the DMA does not own and a current
+ * descriptor that has reached it means an empty ring rather than a full
+ * one.
+ */
+static void stmmac_rx_low_water(struct stmmac_priv *priv, u32 queue)
+{
+	struct stmmac_rx_queue *rx_q = &priv->dma_conf.rx_queue[queue];
+	u32 size = priv->dma_conf.dma_rx_size;
+	unsigned int desc_size;
+	dma_addr_t addr, offset;
+	u32 avail, head;
+
+	if (rx_q->dirty_rx == rx_q->cur_rx)
+		return;
+
+	if (stmmac_rx_desc_ptr(priv, priv->dmaaddr, queue, &addr))
+		return;
+
+	desc_size = priv->extend_desc ? sizeof(struct dma_extended_desc) :
+					sizeof(struct dma_desc);
+
+	/* A current descriptor outside the ring is a fault in its own right;
+	 * do not fold the index it would produce into the measurement.
+	 */
+	if (addr < rx_q->dma_rx_phy)
+		return;
+	offset = addr - rx_q->dma_rx_phy;
+	if (offset >= (dma_addr_t)size * desc_size)
+		return;
+
+	head = (u32)offset / desc_size;
+	avail = (rx_q->dirty_rx + size - head) % size;
+	if (avail < priv->xstats.rx_desc_low_water)
+		priv->xstats.rx_desc_low_water = avail;
+}
+
 static bool stmmac_eee_tx_busy(struct stmmac_priv *priv)
 {
 	u32 tx_cnt = priv->plat->tx_queues_to_use;
@@ -5658,6 +5705,7 @@ drain_data:
 
 	stmmac_finalize_xdp_rx(priv, xdp_status);
 
+	stmmac_rx_low_water(priv, queue);
 	stmmac_rx_refill(priv, queue);
 
 	u64_stats_update_begin(&rxq_stats->napi_syncp);
@@ -7800,6 +7848,7 @@ static void stmmac_reset_rx_queue(struct stmmac_priv *priv, u32 queue)
 
 	rx_q->cur_rx = 0;
 	rx_q->dirty_rx = 0;
+	priv->xstats.rx_desc_low_water = priv->dma_conf.dma_rx_size;
 }
 
 static void stmmac_reset_tx_queue(struct stmmac_priv *priv, u32 queue)
