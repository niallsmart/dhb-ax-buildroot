+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/hisilicon,hi3531-usb-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3531 USB 2.0 PHY
+
+maintainers:
+  - Niall Smart <niall.smart@gmail.com>
+
+description:
+  The Hi3531 USB PHY uses control fields in the shared peripheral clock and
+  reset generator and in the system controller. It is shared by the EHCI and
+  OHCI host controllers.
+
+properties:
+  compatible:
+    const: hisilicon,hi3531-usb-phy
+
+  reg:
+    items:
+      - description: Shared peripheral clock and reset generator registers
+      - description: Shared system-controller registers
+
+  reg-names:
+    items:
+      - const: crg
+      - const: sysctrl
+
+  '#phy-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#phy-cells'
+
+additionalProperties: false
+
+...
