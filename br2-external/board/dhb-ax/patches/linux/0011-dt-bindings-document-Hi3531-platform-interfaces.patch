+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/hisilicon,hi3531-uart-mux.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3531 UART clock source mux
+
+maintainers:
+  - Niall Smart <niall.smart@gmail.com>
+
+description:
+  A bit in the peripheral clock and reset generator selects the slow or full
+  rate clock source for the Hi3531 UARTs. The early clock initializer selects
+  the full-rate source before the serial driver probes.
+
+properties:
+  compatible:
+    const: hisilicon,hi3531-uart-mux
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+...
