diff --git a/Documentation/devicetree/bindings/arm/hisilicon/hisilicon,hi3531-smp.yaml b/Documentation/devicetree/bindings/arm/hisilicon/hisilicon,hi3531-smp.yaml
new file mode 100644
index 000000000000..bb299185aab9
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/hisilicon/hisilicon,hi3531-smp.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/hisilicon/hisilicon,hi3531-smp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3531 secondary CPU enable method
+
+maintainers:
+  - Niall Smart <niall.smart@gmail.com>
+
+description:
+  Vendor firmware releases the second Cortex-A9 core and leaves it polling a
+  system-controller word for an entry point. The operating system enables the
+  SCU and writes the physical secondary startup address to that word.
+
+select:
+  properties:
+    enable-method:
+      const: hisilicon,hi3531-smp
+  required:
+    - enable-method
+
+properties:
+  $nodename:
+    const: cpus
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 0
+
+  enable-method:
+    const: hisilicon,hi3531-smp
+
+patternProperties:
+  '^cpu@[0-9a-f]+$':
+    type: object
+    additionalProperties: true
+
+required:
+  - '#address-cells'
+  - '#size-cells'
+  - enable-method
+
+additionalProperties: false
+
+...
