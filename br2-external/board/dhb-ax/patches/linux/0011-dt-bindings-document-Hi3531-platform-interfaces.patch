 .../arm/hisilicon/hisilicon,hi3531-smp.yaml   | 49 +++++++++++++++++++
 .../bindings/arm/hisilicon/hisilicon.yaml     |  5 ++
 .../bindings/ata/hisilicon,hi3531-ahci.yaml   | 40 +++++++++++++++
 .../clock/hisilicon,hi3531-uart-mux.yaml      | 30 ++++++++++++
 .../phy/hisilicon,hi3531-usb-phy.yaml         | 42 ++++++++++++++++
 .../devicetree/bindings/vendor-prefixes.yaml  |  2 +
 7 files changed, 176 insertions(+), 4 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/arm/hisilicon/hisilicon,hi3531-smp.yaml
 create mode 100644 Documentation/devicetree/bindings/ata/hisilicon,hi3531-ahci.yaml
 create mode 100644 Documentation/devicetree/bindings/clock/hisilicon,hi3531-uart-mux.yaml
 create mode 100644 Documentation/devicetree/bindings/phy/hisilicon,hi3531-usb-phy.yaml

