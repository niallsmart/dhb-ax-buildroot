From: Niall Smart <niall.smart@gmail.com>
Date: Fri, 11 Sep 2026 08:31:13 -0400
Subject: [PATCH 02/13] ARM: hisi: initialize the Hi3531 UART clock mux

U-Boot leaves the UART on its 3 MHz source.  Clear CRG bit 13 during OF
clock initialization so the full console runs at the rate the device tree
describes.
---
 arch/arm/mach-hisi/hisilicon.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm/mach-hisi/hisilicon.c b/arch/arm/mach-hisi/hisilicon.c
index b8d14b369cc9..1a5b0f1f600f 100644
--- a/arch/arm/mach-hisi/hisilicon.c
+++ b/arch/arm/mach-hisi/hisilicon.c
@@ -8,8 +8,12 @@
  * Author: Haojian Zhuang <haojian.zhuang@linaro.org>
 */
 
+#include <linux/bitops.h>
+#include <linux/clk-provider.h>
 #include <linux/clocksource.h>
+#include <linux/io.h>
 #include <linux/irqchip.h>
+#include <linux/of_address.h>
 
 #include <asm/mach/arch.h>
 #include <asm/mach/map.h>
@@ -17,6 +21,29 @@
 #define HI3620_SYSCTRL_PHYS_BASE		0xfc802000
 #define HI3620_SYSCTRL_VIRT_BASE		0xfe802000
 
+/*
+ * U-Boot leaves the Hi3531 UART on its 3 MHz clock source. The vendor
+ * platform code clears CRG bit 13 before registering PL011, selecting the
+ * 155 MHz APB clock instead. Do this during OF clock initialization so the
+ * full console sees the source described by the device tree.
+ */
+static void __init hi3531_uart_mux_init(struct device_node *np)
+{
+	void __iomem *reg;
+	u32 value;
+
+	reg = of_iomap(np, 0);
+	if (!reg)
+		return;
+
+	value = readl(reg);
+	writel(value & ~BIT(13), reg);
+	readl(reg);
+	iounmap(reg);
+}
+CLK_OF_DECLARE(hi3531_uart_mux, "hisilicon,hi3531-uart-mux",
+	       hi3531_uart_mux_init);
+
 /*
  * This table is only for optimization. Since ioremap() could always share
  * the same mapping if it's defined as static IO mapping.
