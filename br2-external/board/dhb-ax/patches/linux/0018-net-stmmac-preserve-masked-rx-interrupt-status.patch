From: DHB_AX local port <local@invalid>
Subject: [LOCAL ONLY] net: stmmac: preserve masked RX interrupt status

The legacy DMA interrupt handler acknowledges every status bit read from
the DMA Status Register [CSR5]. A Transmit Interrupt [TI] can invoke the
shared handler while RX NAPI has Receive Interrupt Enable [RIE] masked. If
Receive Interrupt [RI] is also pending, the handler declines to schedule RX
NAPI but still clears Receive Interrupt [RI]. The DMA can then consume the
remaining descriptors without leaving an event to wake RX NAPI.

Leave Receive Interrupt [RI] pending when Receive Interrupt Enable [RIE] is
masked. The handler still acknowledges the interrupt causes that brought it
in, while the receive event remains available to trigger RX NAPI when the
poll completes and re-enables Receive Interrupt Enable [RIE].

Count preserved receive events and the subset coincident with Transmit
Interrupt [TI]. These temporary ethtool counters make the shared-interrupt
race observable during the reduced-ring stress test.
---
 drivers/net/ethernet/stmicro/stmmac/common.h         | 2 ++
 drivers/net/ethernet/stmicro/stmmac/dwmac_lib.c      | 8 +++++++-
 drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c | 2 ++
 3 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/common.h b/drivers/net/ethernet/stmicro/stmmac/common.h
--- a/drivers/net/ethernet/stmicro/stmmac/common.h
+++ b/drivers/net/ethernet/stmicro/stmmac/common.h
@@ -131,6 +131,8 @@ struct stmmac_extra_stats {
 	unsigned long rx_napi_complete_cur;
 	unsigned long rx_napi_complete_dirty;
 	unsigned long rx_napi_complete_pending;
+	unsigned long rx_irq_preserved_while_masked;
+	unsigned long rx_irq_preserved_with_tx;
 	unsigned long sa_filter_fail;
 	unsigned long overflow_error;
 	unsigned long ipc_csum_error;
diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac_lib.c b/drivers/net/ethernet/stmicro/stmmac/dwmac_lib.c
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac_lib.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac_lib.c
@@ -234,6 +234,12 @@ int dwmac_dma_interrupt(struct stmmac_priv *priv, void __iomem *ioaddr,
 				u64_stats_update_end(&stats->syncp);
 				ret |= handle_rx;
-			}
+			} else {
+				x->rx_irq_preserved_while_masked++;
+				if (intr_status & DMA_STATUS_TI)
+					x->rx_irq_preserved_with_tx++;
+				/* Let Receive Interrupt [RI] wake the rearmed NAPI. */
+				intr_status &= ~DMA_STATUS_RI;
+			}
 		}
 		if (likely(intr_status & DMA_STATUS_TI)) {
 			u64_stats_update_begin(&stats->syncp);
diff --git a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_ethtool.c
@@ -66,6 +66,8 @@ static const struct stmmac_stats stmmac_gstrings_stats[] = {
 	STMMAC_STAT(rx_napi_complete_cur),
 	STMMAC_STAT(rx_napi_complete_dirty),
 	STMMAC_STAT(rx_napi_complete_pending),
+	STMMAC_STAT(rx_irq_preserved_while_masked),
+	STMMAC_STAT(rx_irq_preserved_with_tx),
 	STMMAC_STAT(sa_filter_fail),
 	STMMAC_STAT(overflow_error),
 	STMMAC_STAT(ipc_csum_error),
