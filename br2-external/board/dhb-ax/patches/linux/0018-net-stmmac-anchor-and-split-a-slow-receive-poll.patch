From: DHB_AX local port <local@invalid>
Subject: [LOCAL ONLY] net: stmmac: anchor and split a slow receive poll

rx_desc_low_water and rx_poll_gap_us describe the same poll but are read a
second later through ethtool, so they cannot be placed against the
interrupt and softirq events around it.  Emit the reading into the ftrace
buffer as it is taken.

The interval that reading carries spans the previous poll's refill and
this poll's receive loop.  Time both and report them when a poll runs
long, so an eleven-millisecond poll can be attributed to one or the other.

Diagnostic only.  Remove once the slow poll is accounted for; the
trace_printk announces itself in the kernel log and has no place in a
shipped image.
--- a/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac_main.c
@@ -33,6 +33,7 @@
 #include <linux/prefetch.h>
 #include <linux/math64.h>
 #include <linux/sched/clock.h>
+#include <linux/trace_printk.h>
 #include <linux/pinctrl/consumer.h>
 #ifdef CONFIG_DEBUG_FS
 #include <linux/debugfs.h>
@@ -393,6 +394,15 @@
 	avail = (rx_q->dirty_rx + size - head) % size;
 	gap = last ? div_u64(now - last, NSEC_PER_USEC) : 0;
 
+	/* Anchor a deep backlog in the ftrace timeline, so the interval this
+	 * poll reports can be read against the interrupt and softirq events
+	 * either side of it rather than inferred from two counters sampled a
+	 * second apart.  Remove once that question is answered.
+	 */
+	if (avail < size / 4)
+		trace_printk("rx_low_water avail=%u head=%u dirty=%u cur=%u gap=%u\n",
+			     avail, head, rx_q->dirty_rx, rx_q->cur_rx, gap);
+
 	if (avail < priv->xstats.rx_desc_low_water) {
 		priv->xstats.rx_desc_low_water = avail;
 		priv->xstats.rx_poll_gap_us = gap;
@@ -5489,6 +5499,7 @@
 	struct stmmac_xdp_buff ctx;
 	int xdp_status = 0;
 	int bufsz;
+	u64 t_entry = local_clock(), t_body, t_refill;
 
 	dma_dir = page_pool_get_dma_dir(rx_q->page_pool);
 	bufsz = DIV_ROUND_UP(priv->dma_conf.dma_buf_sz, PAGE_SIZE) * PAGE_SIZE;
@@ -5744,7 +5755,19 @@
 	stmmac_finalize_xdp_rx(priv, xdp_status);
 
 	stmmac_rx_low_water(priv, queue);
+
+	/* Split the interval stmmac_rx_low_water() reports.  It spans the
+	 * previous poll's refill and this poll's receive loop, and an
+	 * eleven-millisecond poll could be either.  Remove with the anchor
+	 * below once that is settled.
+	 */
+	t_body = local_clock();
 	stmmac_rx_refill(priv, queue);
+	t_refill = local_clock();
+	if (t_refill - t_entry > 1 * NSEC_PER_MSEC)
+		trace_printk("rx_slow_poll packets=%u body=%llu us refill=%llu us\n",
+			     count, div_u64(t_body - t_entry, NSEC_PER_USEC),
+			     div_u64(t_refill - t_body, NSEC_PER_USEC));
 
 	u64_stats_update_begin(&rxq_stats->napi_syncp);
 	u64_stats_add(&rxq_stats->napi.rx_packets, rx_packets);
