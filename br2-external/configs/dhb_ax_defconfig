# Buildroot configuration for the DHB-AX board (HiSilicon Hi3531, "godnet").
#
# Build with scripts/buildroot.sh.  See docs/buildroot-migration-plan.md.
#
# Stage 3: the kernel is built from the patch queue and device trees under
# board/dhb_ax/, and packaged as the appended-DTB uImage the vendor U-Boot
# needs.  Stage 4 adds the userspace tools the roadmap wants.

# Target.  Dual Cortex-A9.  The vendor 3.0.8 godnet_defconfig sets CONFIG_VFP
# and CONFIG_VFPv3 but leaves CONFIG_NEON unset, and nothing has confirmed
# NEON on this part, so it stays off -- matching what the working kernel is
# built with today.
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_VFPV3D16=y

# Toolchain: built from source by Buildroot.
#
# The migration plan called for an external toolchain, on the reasoning that
# building one costs most of an hour.  Both external options were tried and
# neither works on this host:
#
#   Debian's gcc-arm-linux-gnueabihf, used by the retired pre-Buildroot build, is
#   rejected outright.  Buildroot checks `gcc -v` for --with-sysroot=/ and
#   refuses any toolchain configured that way -- "Distribution toolchains are
#   unsuitable for use by Buildroot" (toolchain/helpers.mk:458).  It is a
#   deliberate block, not a missing dependency.
#
#   Bootlin's prebuilt toolchains are x86_64 binaries, and the option carries
#   `depends on BR2_HOSTARCH = "x86_64"`.  The container is aarch64 on an
#   Apple Silicon host, so the symbol does not exist and setting it silently
#   does nothing -- which is what the defconfig check in
#   scripts/buildroot-in-container.sh now catches.
#
# So the toolchain is built here.  It is a one-time cost: the output tree
# lives in a Docker named volume that survives between runs.
#
# glibc rather than uClibc or musl, because BR2_TIME_BITS_64 -- the 64-bit
# time_t that Stage 4 needs to fix `ls` on the DVR's FAT32 partitions --
# depends on glibc.  Headers come from the kernel being built, so there is
# only one kernel version in play.
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# The patch queue.  Buildroot looks for <dir>/<package>/*.patch, so the eleven
# kernel patches live in board/dhb_ax/patches/linux/.  They are applied to a
# freshly extracted tree every time, which is what removes the need for the
# reverse-apply idempotency check the old build carries.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb_ax/patches"

# Kernel.  The tarball is the one bootstrap-sources.sh already pins, reused
# rather than downloaded a second time.  /work is the repository root as
# mounted by scripts/buildroot.sh.
#
# linux.config is a *full* .config, not a savedefconfig.  Buildroot copies it
# into place and runs olddefconfig, which gives any absent symbol its Kconfig
# default -- the opposite of the KCONFIG_ALLCONFIG + allnoconfig the old build
# uses, where absent means no.  A minimal defconfig here would silently turn
# on a great deal.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="file:///work/kernel/linux-6.18.42.tar.xz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb_ax/linux.config"

# The vendor U-Boot 2010.06 has no FDT commands and passes ATAGs, so the DTB
# rides appended to the zImage inside a legacy uImage.
#
# BR2_LINUX_KERNEL_APPENDED_UIMAGE does exactly that and cannot be used here:
# its two loops over LINUX_DTS_NAME disagree about basename, which breaks as
# soon as a device tree sits in a subdirectory -- and ours must, because patch
# 0001 wires them into arch/arm/boot/dts/hisilicon/Makefile.  The kernel is
# built as a plain zImage and board/dhb_ax/post-image.sh does the append and
# the mkimage wrap, with the same arguments the old build used.
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb_ax/post-image.sh"

# post-image.sh needs mkimage.  Buildroot selects host-uboot-tools
# automatically for the uImage kernel targets, and we do not use those, so it
# has to be asked for by name.  Nothing warns about this: the build gets all
# the way to the post-image step and then exits 127.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# CUSTOM_DTS_DIR rsyncs the tree in preserving structure, so dts/hisilicon/
# lands at arch/arm/boot/dts/hisilicon/ -- where patch 0001 already adds both
# DTBs to the Makefile.  Matching the kernel's own layout means that patch
# needs no change.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb_ax/dts"

# Keep userspace outside the legacy uImage. Vendor U-Boot rejects the
# OpenSSH-enabled initramfs because its 9.9 MiB payload crosses U-Boot's kernel
# size guard. The kernel obtains the board's reserved address by DHCP and
# mounts the Buildroot rootfs exported by the Raspberry Pi; Buildroot emits a
# tar archive for scripts/publish-nfs-root.sh to publish there.
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_CPIO is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb_ax/rootfs-overlay"
BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_HOSTNAME="dhb-ax"

# Early kernel DHCP is what makes the NFS root mount possible. Do not ask
# Buildroot's init scripts to run DHCP a second time: deconfiguring eth0 under
# a live NFS root can deadlock the system. OpenSSH starts through the normal
# Buildroot init scripts. It is key-only: root remains available on the
# physical serial console, but an empty root password must never grant network
# access. Host and authorized keys are injected from ignored local inputs by
# post-build.sh.
BR2_SYSTEM_DHCP=""
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_OPENSSH_CLIENT is not set
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_OPENSSH_SANDBOX=y
# BR2_PACKAGE_DROPBEAR is not set
# BR2_PACKAGE_LIGHTTPD is not set

# 64-bit time_t.  The symptom this was meant to cure -- `ls` on the DVR's
# FAT32 partitions reporting "Value too large for defined data type" -- had
# already gone by Stage 3 without it, but relying on a default nobody chose is
# how it comes back.  glibc needs 64-bit file offsets alongside, which
# Buildroot selects automatically.
BR2_TIME_BITS_64=y

# Flash tools, read-only members only.  This board's SPI NOR and NAND hold the
# only factory system and the standing rule is that nothing writes to them, so
# an image that cannot perform the operation beats remembering not to type it.
#
# Careful: mtd's sub-options default to y.  Selecting BR2_PACKAGE_MTD alone
# installs flash_erase, flashcp, nandwrite, ubiformat and the rest -- naming
# the three we want does nothing, because they were already on.  The writers
# have to be turned off by name.  post-build.sh then checks the result, since
# not every tool has a symbol to switch off.
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_MTDINFO=y
BR2_PACKAGE_MTD_NANDDUMP=y
BR2_PACKAGE_MTD_MTD_DEBUG=y
# BR2_PACKAGE_MTD_FLASHCP is not set
# BR2_PACKAGE_MTD_FLASH_ERASE is not set
# BR2_PACKAGE_MTD_FLASH_LOCK is not set
# BR2_PACKAGE_MTD_FLASH_UNLOCK is not set
# BR2_PACKAGE_MTD_NANDWRITE is not set
# BR2_PACKAGE_MTD_NANDTEST is not set
# BR2_PACKAGE_MTD_UBIFORMAT is not set
# BR2_PACKAGE_MTD_UBIMKVOL is not set
# BR2_PACKAGE_MTD_UBIRMVOL is not set
# BR2_PACKAGE_MTD_UBIRSVOL is not set
# BR2_PACKAGE_MTD_UBIRENAME is not set
# BR2_PACKAGE_MTD_UBIUPDATEVOL is not set
# BR2_PACKAGE_MTD_UBINIZE is not set
# BR2_PACKAGE_MTD_UBIHEALTHD is not set

# Runtime validation uses ethtool for link and MAC capability inspection, and
# i2c-tools for the bit-banged bus and DS1307-compatible RTC.
#
# i2c-tools is hidden unless BUSYBOX_SHOW_OTHERS is set -- Buildroot conceals
# packages that overlap a BusyBox applet.  Without it the selection below is
# dropped silently, which is what the defconfig check in
# scripts/buildroot-in-container.sh caught.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_I2C_TOOLS=y

# Filesystem inspection for the DVR's disk, again read-only members only.
# debugfs walks an ext filesystem without mounting it; `fsck.fat -n` reports
# without repairing.  mkfs.fat, resize2fs and e2fsck are left out on purpose:
# the disk holds the owner's recordings.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_DEBUGFS=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set
# BR2_PACKAGE_E2FSPROGS_RESIZE2FS is not set
# BR2_PACKAGE_E2FSPROGS_E4DEFRAG is not set
# e2scrub is not listed: it needs bash, coreutils, lvm2 and util-linux, none
# of which are selected, so kconfig drops the symbol entirely rather than
# writing it as unset.  Asserting on it would fail for the wrong reason.
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
# BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT is not set
# BR2_PACKAGE_DOSFSTOOLS_FATLABEL is not set

# mke2fs has no Kconfig symbol -- e2fsprogs installs it as part of the base
# package -- so it can only be removed after the fact.  post-build.sh does
# that, and fails the build if anything on its list is still there.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb_ax/post-build.sh"
BR2_ROOTFS_POST_BUILD_SCRIPT_ARGS="$(BR2_EXTERNAL_DHB_AX_PATH)/../artifacts/local/ssh"
