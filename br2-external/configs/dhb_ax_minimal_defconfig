# Diagnostic image for the DHB_AX board (HiSilicon Hi3531).

# Match dhb_ax_defconfig's verified ARM ABI.
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_VFPV3D16=y

# scripts/buildroot.sh --config toolchain stages the shared musl SDK.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="file:///dl/arm-buildroot-linux-musleabihf_sdk-buildroot.tar.gz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-buildroot-linux-musleabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_14=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_18=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y

BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=10G"

BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/patches"

# linux-minimal.config retains only the recovery and storage-bootstrap drivers.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.42"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/linux-minimal.config"
# post-image-minimal.sh produces the legacy uImage loaded by vendor U-Boot.
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/post-image-minimal.sh"
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/dts"

# Embed the root filesystem in the minimal kernel.
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/busybox-network.fragment $(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/busybox-minimal.fragment $(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/busybox-debug.fragment"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/rootfs-overlay-network"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_HOSTNAME="minimal"
# The serial getty authenticates root with the password from gitignored local.env.
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD="$(DHB_AX_ROOT_PASSWD)"

# DHCP obtains the board's reservation after the network overlay applies its
# factory MAC address.
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_DROPBEAR=y
# The rescue interface accepts public-key authentication only. Omit the client
# to retain the vendor U-Boot payload margin.
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_SMALL=y
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS_FILE="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/dropbear-localoptions.h"
BR2_PACKAGE_GESFTPSERVER=y
# BR2_PACKAGE_OPENSSH is not set

# Provision the approved SATA and USB devices before a production root exists.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y

# The post-build script installs SSH material, verifies bootstrap tools and
# rejects flash writers.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DHB_AX_PATH)/board/dhb-ax/post-build-minimal.sh"
BR2_ROOTFS_POST_BUILD_SCRIPT_ARGS="$(BR2_EXTERNAL_DHB_AX_PATH)/../artifacts/local/ssh"
