# Shared cross-toolchain for every DHB_AX image configuration.
#
# Build and stage it with:
#
#   scripts/buildroot.sh --config toolchain

BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_VFPV3D16=y

BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_18=y

# This configuration exports the compiler and sysroot only. Avoid inheriting
# Buildroot's default init, BusyBox and tar-rootfs selections: make sdk depends
# on world, and those defaults would otherwise create an unrelated image.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_TARGET_ROOTFS_TAR is not set

# BR2_CCACHE_DIR defaults to $HOME/.buildroot-ccache, which the build wrapper
# mounts from the shared dhb-ax-br-ccache volume for every configuration.
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=10G"
