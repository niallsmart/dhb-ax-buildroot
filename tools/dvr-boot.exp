#!/usr/bin/expect -f
# Reliably boot a kernel on the DVR through the Raspberry Pi UART.
#
# By default the image argument is a filename beneath /srv/tftp on the Pi.
# With --stage, the tool first publishes a local image there. With --usb, it
# loads an existing image from the USB FAT filesystem. It never saves the
# U-Boot environment or writes board storage.

proc usage {{status 0}} {
    set stream stdout
    if {$status != 0} { set stream stderr }
    puts $stream {usage: dvr-boot.exp [options] TFTP_IMAGE
       dvr-boot.exp [options] --stage LOCAL_IMAGE
       dvr-boot.exp [options] --usb [USB_IMAGE]

Options:
  --check                 Run read-only preflight checks; do not access the UART
  --stage LOCAL_IMAGE     Stage a local image under its basename before booting
  --usb                   Load from USB FAT (default: /uImage; root: HDD)
  --usb-device DEVICE     U-Boot USB device and partition (default: 0:1)
  --root MODE             Root filesystem: hdd or nfs (default follows loader)
  --host HOST             Pi SSH host (default: raspberrypi)
  --session NAME          persistent tmux console to use (default: dvr)
  --transcript PATH       Append serial output to PATH
  --load-address ADDRESS  U-Boot load address (default: 0x82000000)
  --ipaddr ADDRESS        DVR address used by U-Boot (default: 192.168.7.241)
  --netmask ADDRESS       U-Boot network mask (default: 255.255.252.0)
  --serverip ADDRESS      TFTP server address (default: 192.168.4.34)
  --ethaddr ADDRESS       Temporary U-Boot MAC (default: 00:18:AE:3C:A2:49)
  --boot-timeout SECONDS  Linux prompt timeout (default: 120)
  --help                  Show this help

The named tmux session remains the sole owner of the UART. This tool reads its
pane and sends keys through tmux without restarting the session. USB defaults
to the HDD root and TFTP to the Pi's NFS root; --root overrides either default.}
    exit $status
}

proc option_value {argv_name index_name option} {
    upvar 1 $argv_name args $index_name index
    incr index
    if {$index >= [llength $args]} {
        puts stderr "error: $option requires a value"
        usage 2
    }
    return [lindex $args $index]
}

set host raspberrypi
set session dvr
set transcript ""
set load_address 0x82000000
set ipaddr 192.168.7.241
set netmask 255.255.252.0
set serverip 192.168.4.34
set ethaddr 00:18:AE:3C:A2:49
set boot_timeout 120
set check_only 0
set local_image ""
set image ""
set usb_mode 0
set usb_device 0:1
set root_mode ""

for {set i 0} {$i < [llength $argv]} {incr i} {
    set arg [lindex $argv $i]
    switch -- $arg {
        --check { set check_only 1 }
        --usb { set usb_mode 1 }
        --usb-device { set usb_device [option_value argv i $arg] }
        --root { set root_mode [option_value argv i $arg] }
        --stage {
            if {$local_image ne ""} {
                puts stderr "error: --stage may be specified only once"
                usage 2
            }
            set local_image [option_value argv i $arg]
        }
        --host { set host [option_value argv i $arg] }
        --session { set session [option_value argv i $arg] }
        --transcript { set transcript [option_value argv i $arg] }
        --load-address { set load_address [option_value argv i $arg] }
        --ipaddr { set ipaddr [option_value argv i $arg] }
        --netmask { set netmask [option_value argv i $arg] }
        --serverip { set serverip [option_value argv i $arg] }
        --ethaddr { set ethaddr [option_value argv i $arg] }
        --boot-timeout { set boot_timeout [option_value argv i $arg] }
        --help - -h { usage 0 }
        default {
            if {[string match "--*" $arg]} {
                puts stderr "error: unknown option: $arg"
                usage 2
            }
            if {$image ne ""} {
                puts stderr "error: only one image may be specified"
                usage 2
            }
            set image $arg
        }
    }
}

if {$local_image ne ""} {
    if {$usb_mode} {
        puts stderr "error: --stage and --usb cannot be used together"
        usage 2
    }
    if {$image ne ""} {
        puts stderr "error: use either TFTP_IMAGE or --stage LOCAL_IMAGE, not both"
        usage 2
    }
    if {![file exists $local_image] || ![file isfile $local_image] ||
        ![file readable $local_image]} {
        puts stderr "error: local image is not a readable regular file: $local_image"
        exit 2
    }
    set image [file tail $local_image]
}
if {$image eq "" && $usb_mode} { set image uImage }
if {$image eq ""} { usage 2 }
if {$root_mode eq ""} {
    set root_mode [expr {$usb_mode ? "hdd" : "nfs"}]
}
if {$root_mode ni {hdd nfs}} {
    puts stderr "error: --root must be hdd or nfs"
    exit 2
}
if {![regexp {^[A-Za-z0-9_.@-]+$} $host]} {
    puts stderr "error: unsafe SSH host: $host"
    exit 2
}
if {![regexp {^[A-Za-z0-9_.-]+$} $session]} {
    puts stderr "error: unsafe tmux session name: $session"
    exit 2
}
if {![regexp {^[A-Za-z0-9][A-Za-z0-9._/-]*$} $image] ||
    [lsearch -exact [split $image /] ..] >= 0} {
    puts stderr "error: image must be a safe relative path"
    exit 2
}
if {![regexp {^[0-9]+:[0-9]+$} $usb_device]} {
    puts stderr "error: USB device must have U-Boot form N:P (for example 0:1)"
    exit 2
}
if {![regexp {^0x[0-9A-Fa-f]+$} $load_address]} {
    puts stderr "error: load address must be hexadecimal"
    exit 2
}
foreach {name value} [list ipaddr $ipaddr netmask $netmask serverip $serverip] {
    if {![regexp {^[0-9]{1,3}(\.[0-9]{1,3}){3}$} $value]} {
        puts stderr "error: invalid $name: $value"
        exit 2
    }
}
if {![regexp -nocase {^([0-9a-f]{2}:){5}[0-9a-f]{2}$} $ethaddr]} {
    puts stderr "error: invalid Ethernet address: $ethaddr"
    exit 2
}
if {![string is integer -strict $boot_timeout] || $boot_timeout < 1} {
    puts stderr "error: boot timeout must be a positive integer"
    exit 2
}

proc ssh_command {host command} {
    if {[catch {exec ssh -o BatchMode=yes $host $command} output options]} {
        if {$output ne ""} { puts stderr $output }
        return 0
    }
    return 1
}

proc local_sha256 {path} {
    if {[catch {exec shasum -a 256 -- $path} output]} { return "" }
    if {![regexp -nocase {^([0-9a-f]{64})[ \t]} $output match digest]} {
        return ""
    }
    return [string tolower $digest]
}

proc remote_sha256 {host image} {
    set command "sha256sum /srv/tftp/$image"
    if {[catch {exec ssh -o BatchMode=yes $host $command} output]} { return "" }
    if {![regexp -nocase {^([0-9a-f]{64})[ \t]} $output match digest]} {
        return ""
    }
    return [string tolower $digest]
}

proc stage_image {host local_image image} {
    set remote_temp "/tmp/dvr-boot-[pid]-$image"
    set remote_incoming "/srv/tftp/.dvr-boot-[pid]-$image.incoming"

    puts "Staging $local_image on $host..."
    if {[catch {
        exec scp -q -o BatchMode=yes -- $local_image "$host:$remote_temp"
    } output]} {
        if {$output ne ""} { puts stderr $output }
        puts stderr "error: could not copy the image to $host"
        return 0
    }

    set install_command "sudo install -m0644 $remote_temp $remote_incoming && sudo mv -f $remote_incoming /srv/tftp/$image"
    if {![ssh_command $host $install_command]} {
        ssh_command $host "sudo rm -f $remote_temp $remote_incoming"
        puts stderr "error: could not install the image beneath /srv/tftp"
        return 0
    }
    ssh_command $host "rm -f $remote_temp"
    return 1
}

set local_digest ""
if {$local_image ne ""} {
    set local_digest [local_sha256 $local_image]
    if {$local_digest eq ""} {
        puts stderr "error: could not calculate SHA-256 for $local_image"
        exit 2
    }
}

if {$usb_mode} {
    puts "Preflight: USB $usb_device/$image"
} else {
    puts "Preflight: $host:/srv/tftp/$image"
}
if {![ssh_command $host {if grep -q '^ttyAMA0' /proc/consoles; then echo 'error: ttyAMA0 is a Pi console'; exit 1; fi}]} {
    exit 3
}

if {!$usb_mode} {
    if {$check_only} {
        if {![ssh_command $host {systemctl is-active --quiet tftpd-hpa}]} {
            puts stderr "error: tftpd-hpa is not active"
            exit 3
        }
    } else {
        if {![ssh_command $host {sudo systemctl start tftpd-hpa && systemctl is-active --quiet tftpd-hpa}]} {
            puts stderr "error: could not start tftpd-hpa"
            exit 3
        }
    }
}

if {[catch {exec tmux has-session -t $session}]} {
    puts stderr "error: no tmux session '$session'; start it with: just dvr"
    exit 3
}
set pane_state [string trim [exec tmux display-message -p -t $session {#{pane_current_command} #{pane_dead}}]]
if {$pane_state ne "ssh 0"} {
    puts stderr "error: tmux session '$session' is not a live SSH console ($pane_state)"
    exit 3
}

if {$local_image ne ""} {
    if {!$check_only && ![stage_image $host $local_image $image]} {
        exit 3
    }
    set staged_digest [remote_sha256 $host $image]
    if {$staged_digest eq ""} {
        puts stderr "error: could not calculate SHA-256 for $host:/srv/tftp/$image"
        exit 3
    }
    if {$staged_digest ne $local_digest} {
        if {$check_only} {
            puts stderr "error: staged image does not match $local_image; run without --check to publish it"
        } else {
            puts stderr "error: staged image checksum does not match $local_image"
        }
        exit 3
    }
    puts "SHA-256 verified: $local_digest"
}

if {!$usb_mode} {
    set image_check "test -r /srv/tftp/$image"
    if {![ssh_command $host $image_check]} {
        puts stderr "error: image is not readable beneath /srv/tftp: $image"
        exit 3
    }
}

if {$check_only} {
    puts "Preflight passed; boot automation will use the persistent tmux console '$session'."
    exit 0
}

set tool_lock "/tmp/dvr-tmux-$session.lock"
if {[catch {exec mkdir $tool_lock}]} {
    puts stderr "error: another DVR console tool holds $tool_lock"
    exit 4
}
set lock_held 1
set transcript_marker ""
set command_sequence 0

proc close_console {} {
    global session transcript transcript_marker lock_held tool_lock

    if {$transcript ne "" && $transcript_marker ne ""} {
        if {![catch {exec tmux capture-pane -p -t $session -S -} text]} {
            set marker_at [string last $transcript_marker $text]
            if {$marker_at >= 0} {
                set text [string range $text [expr {$marker_at + [string length $transcript_marker]}] end]
            }
            if {![catch {set transcript_file [open $transcript a]}]} {
                puts $transcript_file $text
                close $transcript_file
            }
        }
    }

    if {$lock_held} {
        catch {file delete -force $tool_lock}
        set lock_held 0
    }
}

proc abort_boot {message code} {
    puts stderr "error: $message"
    close_console
    exit $code
}

proc console_send {text} {
    global session

    set press_enter [string match "*\r" $text]
    if {$press_enter} {
        set text [string range $text 0 end-1]
    }
    if {$text ne "" && [catch {exec tmux send-keys -t $session -l -- $text} output]} {
        abort_boot "could not send keys through tmux: $output" 4
    }
    if {$press_enter && [catch {exec tmux send-keys -t $session Enter} output]} {
        abort_boot "could not send Enter through tmux: $output" 4
    }
}

proc pane_history {} {
    global session
    if {[catch {exec tmux capture-pane -p -t $session -S -300} text]} {
        return ""
    }
    return $text
}

proc pane_history_joined {} {
    global session
    if {[catch {exec tmux capture-pane -p -J -t $session -S -300} text]} {
        return ""
    }
    return $text
}

proc pane_last_line {} {
    global session
    if {[catch {exec tmux capture-pane -p -t $session -S 0} text]} {
        return ""
    }
    set text [string trimright $text " \t\r\n"]
    if {$text eq ""} { return "" }
    return [string trim [lindex [split $text "\n"] end] " \t\r"]
}

# Poll the current pane instead of attaching another terminal. A marker limits
# history matches to output from the command that was just sent.
proc wait_pane {cases seconds {marker ""}} {
    set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
    set marker_seen [expr {$marker eq ""}]

    while {[clock milliseconds] < $deadline} {
        set history [pane_history]
        if {$marker ne ""} {
            set marker_at [string last $marker $history]
            if {$marker_at >= 0} {
                set marker_seen 1
                set history [string range $history [expr {$marker_at + [string length $marker]}] end]
            } elseif {!$marker_seen} {
                after 50
                continue
            }
        }

        set last [pane_last_line]
        foreach {tag source pattern} $cases {
            set value $history
            if {$source eq "last"} { set value $last }
            if {[regexp -- $pattern $value]} { return $tag }
        }
        after 50
    }
    return timeout
}

trap {abort_boot "interrupted" 130} {SIGINT SIGTERM SIGHUP}

# Synchronize with U-Boot, a Linux shell, or a login prompt. The factory and
# mainline systems use different prompts, so handle both without assuming
# which kernel is currently running.
console_send "\r"
set shell_ready 0
set uboot_ready 0
for {set i 0} {$i < 12 && !$shell_ready && !$uboot_ready} {incr i} {
    set state [wait_pane [list \
        uboot last {^hisilicon # *$} \
        shell last {^((~|/) )?# *$} \
        login last {^[^ ]+ login: *$} \
        password last {^Password: *$}] 5]
    switch -- $state {
        uboot { set uboot_ready 1 }
        shell { set shell_ready 1 }
        login { console_send "root\r" }
        password { console_send "1001chin\r" }
        timeout { console_send "\r" }
    }
}
if {!$shell_ready && !$uboot_ready} {
    abort_boot "could not identify the current DVR console state" 5
}

if {!$uboot_ready} {
    puts "Rebooting and interrupting autoboot..."
    # Let a normal init stop services and unmount local filesystems cleanly.
    # The RAM-only rescue image has a custom PID 1 that ignores this request;
    # if its shell prompt returns, fall back to the reboot syscall directly.
    console_send "reboot\r"
    set deadline [expr {[clock milliseconds] + 60000}]
    set force_deadline [expr {[clock milliseconds] + 3000}]
    set force_sent 0
    while {[clock milliseconds] < $deadline && !$uboot_ready} {
        console_send " "
        after 250
        set last [pane_last_line]
        if {[regexp {^hisilicon # *$} $last]} {
            set uboot_ready 1
        } elseif {!$force_sent && [clock milliseconds] >= $force_deadline &&
                  [regexp {^((~|/) )?# *$} $last]} {
            puts "Normal reboot was not handled; forcing reboot..."
            console_send "reboot -f\r"
            set force_sent 1
        }
    }
}
if {!$uboot_ready} {
    abort_boot "did not reach the U-Boot prompt within 60 seconds" 6
}

proc uboot_command {command} {
    global command_sequence
    incr command_sequence
    set marker "__DVR_CMD_[pid]_${command_sequence}__"
    console_send "echo $marker; $command\r"
    set result [wait_pane [list uboot last {^hisilicon # *$}] 10 $marker]
    if {$result ne "uboot"} {
        abort_boot "U-Boot command timed out: $command" 7
    }
}

proc configure_bootargs {root_bootargs} {
    global command_sequence

    set common_bootargs {console=ttyAMA0,115200 earlycon=pl011,0x20080000 keep_bootcon ignore_loglevel mem=512M@0x80000000 mem=512M@0xc0000000}
    set expected "$common_bootargs $root_bootargs"

    # Keep both input lines well below old U-Boot's possible 256-byte console
    # buffer. The second command expands the value installed by the first.
    uboot_command "setenv bootargs $common_bootargs"
    uboot_command "setenv bootargs \${bootargs} $root_bootargs"

    # Read the complete value back. -J joins tmux display wraps so a long but
    # intact environment value can still be compared exactly.
    incr command_sequence
    set marker "__DVR_ARGS_[pid]_${command_sequence}__"
    console_send "echo $marker; printenv bootargs\r"
    if {[wait_pane [list uboot last {^hisilicon # *$}] 10 $marker] ne "uboot"} {
        abort_boot "U-Boot bootargs verification timed out" 7
    }

    set history [pane_history_joined]
    set marker_at [string last $marker $history]
    if {$marker_at < 0} {
        abort_boot "could not isolate U-Boot bootargs output" 7
    }
    set history [string range $history [expr {$marker_at + [string length $marker]}] end]
    set actual ""
    foreach line [split $history "\n"] {
        set line [string trimright $line " \t\r"]
        if {[string match "bootargs=*" $line]} {
            set actual [string range $line [string length "bootargs="] end]
        }
    }
    if {$actual ne $expected} {
        abort_boot "U-Boot bootargs mismatch: expected '$expected', got '$actual'" 7
    }
    puts "Verified U-Boot bootargs."
}

if {$transcript ne ""} {
    set transcript_marker "__DVR_BOOT_[pid]_[clock seconds]__"
    uboot_command "echo $transcript_marker"
}

if {$root_mode eq "hdd"} {
    set root_bootargs {root=PARTUUID=ca264b64-5738-4e60-a0ab-b3c3a4c789c1 rootfstype=ext4 rootwait rw}
    puts "Configuring temporary HDD-root bootargs..."
} else {
    set root_bootargs "root=/dev/nfs nfsroot=$serverip:/srv/dhb-ax/rootfs,vers=3,tcp,nolock ip=${ipaddr}:::${netmask}:dhb-ax:eth0:off rw"
    puts "Configuring temporary NFS-root bootargs..."
}
configure_bootargs $root_bootargs

if {$usb_mode} {
    puts "Scanning USB storage..."
    uboot_command "usb reset"
    puts "Loading USB $usb_device/$image at $load_address..."
    incr command_sequence
    set load_marker "__DVR_USB_[pid]_${command_sequence}__"
    console_send "echo $load_marker; fatload usb $usb_device $load_address $image\r"
    set result [wait_pane [list \
        success history {[0-9]+ bytes read} \
        failure history {(Bad device|Unable to read|no USB devices available|\*\* Invalid partition)}] \
        120 $load_marker]
    if {$result eq "failure"} {
        abort_boot "USB FAT load reported a failure" 8
    }
    if {$result ne "success"} {
        abort_boot "USB FAT load did not complete within 120 seconds" 8
    }
    if {[wait_pane [list uboot last {^hisilicon # *$}] 10] ne "uboot"} {
        abort_boot "U-Boot prompt did not return after USB FAT load" 8
    }
} else {
    puts "Configuring temporary U-Boot networking..."
    uboot_command "setenv ipaddr $ipaddr"
    uboot_command "setenv netmask $netmask"
    uboot_command "setenv serverip $serverip"
    uboot_command "setenv ethaddr $ethaddr"

    puts "Loading $image at $load_address..."
    incr command_sequence
    set load_marker "__DVR_TFTP_[pid]_${command_sequence}__"
    console_send "echo $load_marker; tftp $load_address $image\r"
    set result [wait_pane [list \
        success history {Bytes transferred = [0-9]+} \
        failure history {(TFTP error|Retry count exceeded|Access violation|File not found)}] \
        120 $load_marker]
    if {$result eq "failure"} {
        abort_boot "TFTP reported a transfer failure" 8
    }
    if {$result ne "success"} {
        abort_boot "TFTP did not complete within 120 seconds" 8
    }
    if {[wait_pane [list uboot last {^hisilicon # *$}] 10] ne "uboot"} {
        abort_boot "U-Boot prompt did not return after TFTP" 8
    }
}

puts "Booting from RAM..."
incr command_sequence
set boot_marker "__DVR_BOOTM_[pid]_${command_sequence}__"
console_send "echo $boot_marker; bootm $load_address\r"
set result [wait_pane [list \
    shell last {^((~|/) )?# *$} \
    login last {^[^ ]+ login: *$} \
    panic history {Kernel panic - not syncing}] \
    $boot_timeout $boot_marker]
if {$result eq "panic"} {
    abort_boot "kernel panic" 9
}
if {$result ni {shell login}} {
    abort_boot "Linux login or shell prompt did not appear within $boot_timeout seconds" 9
}

puts "Linux login or shell prompt reached successfully."
close_console
exit 0
