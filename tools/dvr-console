#!/bin/sh
# Attach to the persistent DVR UART console, starting it when necessary.
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$repo/scripts/lib.sh"

require_env_file "$repo/local.env" DHB_AX_PI_IPADDR
export DVR_BOOT_REPO_ROOT="$repo"

preflight() {
	ssh -T "$DHB_AX_PI_IPADDR" '
		flock -n /dev/serial0 true || { echo "DVR UART is already in use" >&2; exit 1; }
	'
}

console="exec ssh -tt $DHB_AX_PI_IPADDR 'exec picocom -b 115200 --omap crcrlf /dev/serial0'"

if ! tmux has-session -t dvr 2>/dev/null; then
	preflight
	tmux start-server \; set-option -g history-limit 100000 \; \
		new-session -d -s dvr "$console"
fi

python3 "$repo/tools/dvr_console_log.py" ensure >/dev/null

if [ -n "${TMUX:-}" ]; then
	exec tmux switch-client -t dvr
else
	exec tmux attach-session -t dvr
fi
