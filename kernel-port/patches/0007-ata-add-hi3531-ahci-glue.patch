From: DHB-AX local port <local@invalid>
Subject: [LOCAL ONLY] ata: add HiSilicon Hi3531 AHCI glue

AHCI platform glue reproducing the vendor hi_sata_init() bring-up
sequence, plus its Kconfig symbol and Makefile entry.
---
diff --git a/drivers/ata/Kconfig b/drivers/ata/Kconfig
--- a/drivers/ata/Kconfig
+++ b/drivers/ata/Kconfig
@@ -271,6 +271,17 @@
 
 	  If unsure, say N.
 
+config AHCI_HI3531
+	tristate "HiSilicon Hi3531 AHCI SATA support"
+	depends on ARCH_HISI || COMPILE_TEST
+	select SATA_HOST
+	help
+	  This option enables support for the HiSilicon Hi3531 onboard AHCI
+	  SATA controller, which needs its clocks enabled and its PHY
+	  configured before the generic platform driver can use it.
+
+	  If unsure, say N.
+
 config AHCI_TEGRA
 	tristate "NVIDIA Tegra AHCI SATA support"
 	depends on ARCH_TEGRA || COMPILE_TEST
diff --git a/drivers/ata/Makefile b/drivers/ata/Makefile
--- a/drivers/ata/Makefile
+++ b/drivers/ata/Makefile
@@ -18,6 +18,7 @@
 obj-$(CONFIG_AHCI_DA850)	+= ahci_da850.o libahci.o libahci_platform.o
 obj-$(CONFIG_AHCI_DM816)	+= ahci_dm816.o libahci.o libahci_platform.o
 obj-$(CONFIG_AHCI_DWC)		+= ahci_dwc.o libahci.o libahci_platform.o
+obj-$(CONFIG_AHCI_HI3531)	+= ahci_hi3531.o libahci.o libahci_platform.o
 obj-$(CONFIG_AHCI_IMX)		+= ahci_imx.o libahci.o libahci_platform.o
 obj-$(CONFIG_AHCI_MTK)		+= ahci_mtk.o libahci.o libahci_platform.o
 obj-$(CONFIG_AHCI_MVEBU)	+= ahci_mvebu.o libahci.o libahci_platform.o
diff --git a/drivers/ata/ahci_hi3531.c b/drivers/ata/ahci_hi3531.c
new file mode 100644
--- /dev/null
+++ b/drivers/ata/ahci_hi3531.c
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HiSilicon Hi3531 (godnet) AHCI glue
+ *
+ * The controller is a stock AHCI 1.2 block with two ports, but it comes out
+ * of chip reset with its clocks gated and its PHY unconfigured, so the
+ * generic platform driver finds every register reading zero.  The sequence
+ * below is the vendor 3.0.8 hi_sata_init() from drivers/ata/ahci_sys.c and
+ * ahci_sys_godnet_defconfig.c, which is the only description of this PHY
+ * that exists.
+ *
+ * Clocks and resets live in one register of the shared peripheral CRG.  On
+ * this board the block is already out of reset at boot and only the clock
+ * enables are missing, but the full sequence is kept so a warm restart from
+ * a kernel that had stopped the controller still works.
+ */
+
+#include <linux/ahci_platform.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "ahci.h"
+
+#define DRV_NAME			"ahci-hi3531"
+
+/* Peripheral CRG, relative to the second reg window. */
+#define HI3531_SATA_CRG			0x00b4
+#define HI3531_SATA_PHY_RST		BIT(0)
+#define HI3531_SATA_HOST_RST		BIT(1)
+#define HI3531_SATA_RST			BIT(2)
+#define HI3531_SATA_TX0_RST		BIT(3)
+#define HI3531_SATA_TX1_RST		BIT(4)
+#define HI3531_SATA_RX0_RST		BIT(5)
+#define HI3531_SATA_RX1_RST		BIT(6)
+#define HI3531_SATA_ALIVE_RST		BIT(7)
+#define HI3531_SATA_PORT1_CKEN		BIT(8)
+#define HI3531_SATA_PORT0_CKEN		BIT(9)
+#define HI3531_SATA_CKEN		BIT(10)
+#define HI3531_SATA_CLK_SEL		BIT(11)
+
+#define HI3531_SATA_CLOCKS		(HI3531_SATA_CKEN | \
+					 HI3531_SATA_PORT0_CKEN | \
+					 HI3531_SATA_PORT1_CKEN)
+#define HI3531_SATA_LANE_RESETS		(HI3531_SATA_RST | \
+					 HI3531_SATA_TX0_RST | \
+					 HI3531_SATA_TX1_RST | \
+					 HI3531_SATA_RX0_RST | \
+					 HI3531_SATA_RX1_RST | \
+					 HI3531_SATA_ALIVE_RST)
+
+/* Vendor registers, relative to the AHCI register base. */
+#define HI3531_PHY0_CTLL		0x54
+#define HI3531_PHY0_CTLH		0x58
+#define HI3531_PHY1_CTLL		0x60
+#define HI3531_PHY1_CTLH		0x64
+#define HI3531_OOB_CTL			0x6c
+#define HI3531_PHY_DIS_CLK		BIT(12)
+
+#define HI3531_PORT_BASE(n)		(0x100 + (n) * 0x80)
+#define HI3531_PORT_FIFOTH		0x44
+#define HI3531_PORT_PHYCTL		0x74
+
+/* Values for this SoC, from the vendor Kconfig defaults for ARCH_GODNET. */
+#define HI3531_PHY_CTLL_1_5G		0x8a0ec788
+#define HI3531_PHY_CTLH_VAL		0x2121
+#define HI3531_OOB_CTL_VAL		0x84060c15
+#define HI3531_PHY_CONFIG_1_5G		0x0e262709
+
+/*
+ * Bit 10 bypasses a controller fetch bug and bit 9 works around a Seagate
+ * read-error problem; the vendor writes this to both ports unconditionally.
+ */
+#define HI3531_PORT_FIFOTH_VAL		0x724
+
+#define HI3531_PORTS			2
+
+static void hi3531_crg_update(void __iomem *crg, u32 clear, u32 set)
+{
+	u32 value = readl(crg + HI3531_SATA_CRG);
+
+	value &= ~clear;
+	value |= set;
+	writel(value, crg + HI3531_SATA_CRG);
+}
+
+static void hi3531_ahci_phy_init(void __iomem *crg, void __iomem *mmio)
+{
+	unsigned int port;
+	u32 value;
+
+	hi3531_crg_update(crg, 0, HI3531_SATA_CLOCKS);
+
+	/*
+	 * Select the PHY clock and apply the port erratum before the
+	 * controller is released, as the vendor does.
+	 */
+	hi3531_crg_update(crg, HI3531_SATA_CLK_SEL, 0);
+	for (port = 0; port < HI3531_PORTS; port++)
+		writel(HI3531_PORT_FIFOTH_VAL,
+		       mmio + HI3531_PORT_BASE(port) + HI3531_PORT_FIFOTH);
+
+	hi3531_crg_update(crg, HI3531_SATA_HOST_RST, 0);
+	msleep(20);
+	hi3531_crg_update(crg, HI3531_SATA_PHY_RST, 0);
+	msleep(20);
+
+	value = readl(mmio + HI3531_PHY0_CTLH);
+	writel(value | HI3531_PHY_DIS_CLK, mmio + HI3531_PHY0_CTLH);
+	value = readl(mmio + HI3531_PHY1_CTLH);
+	writel(value | HI3531_PHY_DIS_CLK, mmio + HI3531_PHY1_CTLH);
+
+	/* 1.5 Gbps only; the vendor's 3 Gbps mode is not used here. */
+	writel(HI3531_PHY_CTLL_1_5G, mmio + HI3531_PHY0_CTLL);
+	writel(HI3531_PHY_CTLH_VAL, mmio + HI3531_PHY0_CTLH);
+	writel(HI3531_PHY_CTLL_1_5G, mmio + HI3531_PHY1_CTLL);
+	writel(HI3531_PHY_CTLH_VAL, mmio + HI3531_PHY1_CTLH);
+	writel(HI3531_OOB_CTL_VAL, mmio + HI3531_OOB_CTL);
+
+	for (port = 0; port < HI3531_PORTS; port++)
+		writel(HI3531_PHY_CONFIG_1_5G,
+		       mmio + HI3531_PORT_BASE(port) + HI3531_PORT_PHYCTL);
+
+	/* Toggle the PHY so the new configuration is sampled. */
+	hi3531_crg_update(crg, 0, HI3531_SATA_PHY_RST);
+	msleep(20);
+	hi3531_crg_update(crg, HI3531_SATA_PHY_RST, 0);
+	msleep(20);
+	hi3531_crg_update(crg, HI3531_SATA_LANE_RESETS, 0);
+	msleep(20);
+}
+
+static const struct scsi_host_template hi3531_ahci_sht = {
+	AHCI_SHT(DRV_NAME),
+};
+
+static const struct ata_port_info hi3531_ahci_port_info = {
+	.flags		= AHCI_FLAG_COMMON,
+	.pio_mask	= ATA_PIO4,
+	.udma_mask	= ATA_UDMA6,
+	.port_ops	= &ahci_platform_ops,
+};
+
+static int hi3531_ahci_probe(struct platform_device *pdev)
+{
+	struct ahci_host_priv *hpriv;
+	struct resource *res;
+	void __iomem *crg;
+	int rc;
+
+	hpriv = ahci_platform_get_resources(pdev, 0);
+	if (IS_ERR(hpriv))
+		return PTR_ERR(hpriv);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!res)
+		return -ENODEV;
+
+	/*
+	 * Map the CRG without claiming the region: this window is the shared
+	 * peripheral CRG and the Ethernet glue already owns it.
+	 */
+	crg = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	if (!crg)
+		return -ENOMEM;
+
+	rc = ahci_platform_enable_resources(hpriv);
+	if (rc)
+		return rc;
+
+	hi3531_ahci_phy_init(crg, hpriv->mmio);
+
+	rc = ahci_platform_init_host(pdev, hpriv, &hi3531_ahci_port_info,
+				     &hi3531_ahci_sht);
+	if (rc)
+		goto disable_resources;
+
+	return 0;
+
+disable_resources:
+	ahci_platform_disable_resources(hpriv);
+	return rc;
+}
+
+static const struct of_device_id hi3531_ahci_of_match[] = {
+	{ .compatible = "hisilicon,hi3531-ahci" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3531_ahci_of_match);
+
+static struct platform_driver hi3531_ahci_driver = {
+	.probe = hi3531_ahci_probe,
+	.remove = ata_platform_remove_one,
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = hi3531_ahci_of_match,
+	},
+};
+module_platform_driver(hi3531_ahci_driver);
+
+MODULE_DESCRIPTION("HiSilicon Hi3531 AHCI glue layer");
+MODULE_LICENSE("GPL");
