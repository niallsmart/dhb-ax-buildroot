CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_HISI=y
CONFIG_ARCH_HI3xxx=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HOTPLUG_CPU=y
CONFIG_HAVE_ARM_SCU=y
CONFIG_ARM_ERRATA_764369=y
CONFIG_AEABI=y
CONFIG_OABI_COMPAT=n
CONFIG_ARM_THUMB=y
CONFIG_VFP=y
CONFIG_NEON=n
CONFIG_KERNEL_GZIP=y
CONFIG_HZ_100=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_APPENDED_DTB=y
# Deliberately OFF. atags_to_fdt.c copies U-Boot's ATAG_MEM into the FDT,
# overwriting the memory node in our device tree. The vendor U-Boot hardcodes
# 256 MiB while the board has 512 MiB, so leaving this on silently discarded
# half the RAM. Nothing is lost by disabling it: CONFIG_CMDLINE_FORCE means
# the ATAG command line is ignored anyway, and the appended-DTB support that
# actually matters is CONFIG_ARM_APPENDED_DTB, which is separate.
CONFIG_ARM_ATAG_DTB_COMPAT=n
CONFIG_CMDLINE="console=ttyAMA0,115200 earlycon=pl011,0x20080000 keep_bootcon ignore_loglevel rdinit=/init"
CONFIG_CMDLINE_FORCE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVMEM=y
CONFIG_MAGIC_SYSRQ=y
# Recovery when the shell is wedged but the kernel is alive: a serial BREAK
# followed by a sysrq command.  Mainline defaults this on; the allnoconfig
# seed drops it, which left us with no recourse but a power cycle.
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_ETHTOOL_NETLINK=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_HI3531=y
CONFIG_DWMAC_GENERIC=n
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=n
CONFIG_FILE_LOCKING=y
CONFIG_MULTIUSER=y
CONFIG_MTD=n
CONFIG_PCI=n
CONFIG_PM=n

# SATA bring-up.  The block layer and SCSI cannot be modules, so they are
# built in; libata and the AHCI platform driver stay loadable so the
# controller can be iterated on with insmod instead of a reboot.
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=m
CONFIG_SATA_HOST=y
# The drives sit behind a JMicron JMB325 port multiplier, so this is not
# optional on this board.  Mainline defaults it to y, but the allnoconfig
# seed turns off everything not named here.
CONFIG_SATA_PMP=y
CONFIG_ATA_VERBOSE_ERROR=y
CONFIG_SATA_AHCI_PLATFORM=m
CONFIG_AHCI_HI3531=m
CONFIG_ATA_SFF=n

# Hardware deadman for the case where even a serial BREAK cannot get in.
# Opt-in: the SP805 only starts once userspace opens /dev/watchdog.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_PL061=y
# Timekeeping is an external DS1307 on a bit-banged I2C bus, not the
# on-chip PL031, so the RTC class waits until GPIO-based I2C exists.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
CONFIG_I2C_ALGOBIT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_DS1307=y
CONFIG_RTC_HCTOSYS=y
# Without these the clock is read once at boot but userspace has no way to
# reach it: no /dev/rtc0 and no sysfs attributes.
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
# USB.  EHCI/OHCI are stock; only the PHY is board-specific.  The FTDI
# serial adapter is the end-to-end test: it should appear as /dev/ttyUSB0.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_GENERIC_PHY=y
CONFIG_PHY_HI3531_USB=y
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=m
CONFIG_WATCHDOG_SYSFS=y

# Filesystems are modules so they can be swapped without a reboot.  The
# partitions are declared FAT32; ext4 is carried as the likely alternative.
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_EXT4_FS=m
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
